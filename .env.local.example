# Supabase プロジェクト設定（病院の全 PC で同じ内容を使うとデータが共有されます）
# Supabase ダッシュボード > Settings > API から取得してください
# このファイルをコピーして .env.local にリネームし、値を入れてください。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# サービスロールキー（PIN ユーザー作成・開発時の自動ログインに使用。Git に含めない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 任意 ---
# PIN ログインを必須にする（起動.bat のログイン省略をやめたいとき）
# ALLOW_PIN_LOGIN_BYPASS=false
