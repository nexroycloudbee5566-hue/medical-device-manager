# Supabase プロジェクト設定（病院の全 PC で同じ内容を使うとデータが共有されます）
# Supabase ダッシュボード > Settings > API から取得してください
# このファイルをコピーして .env.local にリネームし、値を入れてください。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# サービスロールキー（PIN ユーザー作成・開発時の自動ログインに使用。Git に含めない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 任意（ログイン）---
# PIN ログインを必須にする（次の2行をセットで false）
# ALLOW_PIN_LOGIN_BYPASS=false
# NEXT_PUBLIC_ALLOW_PIN_LOGIN_BYPASS=false

# ログイン省略時に使うユーザー（省略時は管理者の先頭 1 人）
# DEV_AUTO_LOGIN_ROLE=staff
# DEV_AUTO_LOGIN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ブラウザを閉じてもサーバーを止めない（開発 PC 向け）
# DEV_SHUTDOWN_WITH_BROWSER=false
